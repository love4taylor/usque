[Unit]
Description=Usque WARP global VPN via Linux TPROXY and nftables
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/libexec/usque
Environment=USQUE_CONFIG=/etc/usque/config.json
Environment=USQUE_TPROXY_BIND=127.0.0.1
Environment=USQUE_TPROXY_BIND_V6=::1
Environment=USQUE_TPROXY_PORT=12345
Environment=USQUE_TPROXY_NFT_TABLE=usque_tproxy
Environment=USQUE_TPROXY_TABLE=100
Environment=USQUE_TPROXY_MARK=0x1/0x1
Environment=USQUE_TPROXY_RULE_PRIORITY=100
Environment=USQUE_HTTP2=0
Environment=USQUE_IPV6=0
Environment=USQUE_TPROXY_TCP_L4=1
ExecStartPre=/usr/bin/test -x /usr/local/libexec/usque/usque
ExecStartPre=/usr/bin/test -r /etc/usque/config.json
ExecStart=/usr/local/libexec/usque/run-tproxy.sh
ExecStopPost=/usr/local/libexec/usque/tproxy-nftables-down.sh
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStartSec=90s
TimeoutStopSec=20s
TimeoutStopFailureMode=kill
SuccessExitStatus=130 143
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=false
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
